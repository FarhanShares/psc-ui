{
  "name": "PetSafeCare",
  "short_name": "PetSafeCare",
  "description": "Pet supplies, vet bookings and vaccine reminders in one app.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f5f0",
  "theme_color": "#f7f5f0",
  "categories": ["shopping", "health", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Book a vet", "url": "/clinics", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shop", "url": "/shop", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Emergency", "url": "/emergency", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
